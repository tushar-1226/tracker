# Postgres connection string. On Vercel: Storage -> Create Database -> Neon sets this for you.
# Locally: any Postgres, e.g. postgres://localhost:5432/track (or a Neon dev branch).
DATABASE_URL=postgres://localhost:5432/track
# generate with: openssl rand -base64 32
SESSION_SECRET=
# web push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# random string; send as "Authorization: Bearer <secret>" to /api/cron/reminders
CRON_SECRET=
